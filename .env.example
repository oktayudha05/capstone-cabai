# dummy = simulator lokal di browser, mqtt = broker pihak ketiga
VITE_DATA_SOURCE=dummy

# HiveMQ public broker menyediakan WebSocket TLS di 8884 (path /mqtt).
# Catatan: broker publik HiveMQ tanpa autentikasi, topik bisa dibaca siapa saja.
# Jangan kirim data sensitif lewat broker ini.
VITE_MQTT_URL=wss://broker.hivemq.com:8884/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
VITE_MQTT_TOPIC_PREFIX=capstone/cabai
